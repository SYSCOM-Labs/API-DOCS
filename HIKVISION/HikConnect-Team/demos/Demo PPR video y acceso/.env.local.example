# --- POC ---
# live | mock  (mock no toca el tenant HCT)
POC_MODE=live
# true = los comandos de puerta NO se envian a HCT, solo se auditan.
# Es solo el default: se puede cambiar en caliente desde /settings.
POC_DRY_RUN=true

# Sesion propia de la POC (cambiar en cualquier entorno real)
SESSION_SECRET=cambia-esto-por-un-secreto-largo-aleatorio
POC_ADMIN_PASSWORD=admin
POC_VIEWER_PASSWORD=visor

# --- Hik-Connect for Teams OpenAPI ---
# Vacias a proposito: cada navegador captura AppKey/SecretKey la primera vez
# (cookie cifrada poc_hct en ese dispositivo). No se guardan en el servidor.
HCT_HOST=https://ius.hikcentralconnect.com
HCT_APP_KEY=
HCT_SECRET_KEY=

# IDs de camara visibles, separados por coma (vacia = todas)
CAMERA_ALLOWLIST=

# (Opcional, fallback) codigos de verificacion: {"SERIAL":"codigo"}
# Normalmente viven en data/device-codes.json y se capturan desde la UI.
HCT_DEVICE_CODES_JSON={}
