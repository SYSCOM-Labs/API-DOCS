# Puerto del servidor local (opcional, por defecto 3000)
PORT=3000

# Lista blanca de gateways permitidos (anti-SSRF), separada por comas.
# El proxy solo reenviará a estos hosts. Déjelo vacío para permitir
# cualquier host (cómodo en desarrollo, pero inseguro).
# Ejemplo:
# ALLOWED_GATEWAYS=mi-gateway.midominio.com,10.0.0.20
ALLOWED_GATEWAYS=
